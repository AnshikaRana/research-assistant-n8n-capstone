      "id": "4f9fad38-94d0-4c49-b9ed-ae13ec6f058e",
      "name": "Valid Input?"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst topicId =\n  `TOPIC-${Date.now()}-${Math.random()\n    .toString(36)\n    .substring(2, 7)\n    .toUpperCase()}`;\n\nconst keywords = [...new Set(data.keywords\n  .map(k => String(k).trim().toLowerCase())\n  .filter(Boolean))]\n  .join(', ');\n\nconst email = data.email.trim().toLowerCase();\n// collapse whitespace so \"LLM  agents\" and \"LLM agents\" are the same topic\nconst topic = data.topic.trim().replace(/\\s+/g, ' ');\n\nreturn {\n  json: {\n    topic_id: topicId,\n    researcher: data.researcher.trim(),\n    email,\n    topic,\n    // case-insensitive duplicate key: one researcher (email) cannot register the same topic twice\n    topic_key: `${email}|${topic.toLowerCase()}`,\n    keywords,\n    frequency: data.frequency || 'weekly',\n    active: true\n  }\n};",
        "mode": "runOnceForEachItem"
      },
