      "id": "f0ad9fb3-f26f-447a-841a-02be06b47365",
      "name": "Get Active Topics"
    },
    {
      "parameters": {
        "jsCode": "// Decide which active topics get a digest today, honouring the\n// frequency chosen at registration (daily | weekly = Monday | monthly = 1st).\n// A manual test run sends digests for every active topic.\nconst manual = $('Manual Run (testing)').isExecuted;\nconst today = $now.setZone('Asia/Kolkata');\nconst due = f => manual || f === 'daily' || (f === 'weekly' && today.weekday === 1) || (f === 'monthly' && today.day === 1);\nreturn $input.all()\n  .filter(i => i.json.active === true && i.json.email && due(String(i.json.frequency || 'weekly')))\n  .map(i => ({ json: { topic_id: i.json.topic_id, topic: i.json.topic, researcher: i.json.researcher,\n                       email: i.json.email, keywords: i.json.keywords, frequency: i.json.frequency } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "23963488-4b55-4a99-a616-fd5e8e3fd052",
      "name": "Select Topics Due Today"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "lyPPJZ6tVkwJ23CJ",
          "mode": "list",
          "cachedResultName": "research_papers",
          "cachedResultUrl": "/projects/YqJ3CwtTpfzXuOD6/datatables/lyPPJZ6tVkwJ23CJ"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "processing_status",
              "condition": "eq",
              "keyValue": "summarized"
            },
            {
              "keyName": "digested",
              "condition": "isFalse"
            }
          ]
        },
        "returnAll": true
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "id": "baf8aa5c-7663-46ae-9f59-dfc28bee30b8",
      "name": "Get Undigested Papers",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Attach each due topic's new (not yet digested) summarized papers\nconst topics = $('Select Topics Due Today').all().map(i => i.json);\nconst papers = $input.all().map(i => i.json).filter(p => p.paper_id);\nconst out = [];\nfor (const t of topics) {\n  const mine = papers\n    .filter(p => p.topic_id === t.topic_id)\n    .sort((a, b) => (b.relevance_score || 0) - (a.relevance_score || 0))\n    .slice(0, 10);\n  if (!mine.length) continue;  // nothing new -> no email\n  out.push({ json: { ...t, paper_count: mine.length, paper_ids: mine.map(p => p.paper_id), papers: mine.map(p => ({\n    paper_id: p.paper_id, title: p.title, authors: p.authors, url: p.url, publication_date: p.publication_date,\n    summary: p.summary, key_findings: p.key_findings, category: p.research_category, keywords: p.extracted_keywords,\n    relevance_score: p.relevance_score, citation_apa: p.citation_apa, drive_file_url: p.drive_file_url, pdf_url: p.pdf_url\n  })) } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "dd72dd9b-a613-4bb7-8ea8-8853ad91a5ca",
      "name": "Group Papers by Topic"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are writing the opening of a research digest email for {{ $json.researcher }}.\nResearch Topic: {{ $json.topic }}\nNew papers (title :: summary):\n{{ $json.papers.map((p, i) => (i + 1) + '. ' + p.title + ' :: ' + (p.summary || '')).join('\\n') }}\n\nReturn ONLY valid JSON in exactly this format:\n{\n\"overview\": \"3-4 sentence overview of what these papers collectively show\",\n\"trends\": [\"2-4 short emerging trends\"],\n\"recommended_first\": [\"up to 3 paper titles copied exactly from the list, most important first\"],\n\"open_questions\": [\"1-3 open research questions\"]\n}\nDo not return Markdown or any text outside the JSON object.",
        "messages": {
          "messageValues": []
        },
        "batching": {
          "batchSize": 3,
          "delayBetweenBatches": 1000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1100,
        0
      ],
      "id": "1f275d94-f10d-4d17-bbbd-33850a6197d0",
      "name": "Write Digest Overview",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1100,
        220
      ],
      "id": "58a5b05a-e245-4a83-a48d-82e02264014c",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode": "function parseLlmJson(text) {\n  const raw = String(text ?? '')\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/```\\s*$/, '')\n    .trim();\n  return JSON.parse(raw);\n}\n\n// Build the HTML digest. If the AI overview fails, fall back to a plain list.\nconst groups = $('Group Papers by Topic').all();\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst list = v => { try { const a = typeof v === 'string' ? JSON.parse(v) : v; return Array.isArray(a) ? a : []; } catch { return []; } };\n\nreturn $input.all().map((item, i) => {\n  const g = groups[i].json;\n  let ai = null;\n  try { ai = item.json.error ? null : parseLlmJson(item.json.text); } catch { ai = null; }\n  const titles = new Set(g.papers.map(p => p.title));\n  const recommended = list(ai?.recommended_first).filter(t => titles.has(t));\n\n  const intro = ai?.overview\n    ? `<p>${esc(ai.overview)}</p>` +\n      (list(ai.trends).length ? `<p><b>Emerging trends:</b></p><ul>${list(ai.trends).map(t => `<li>${esc(t)}</li>`).join('')}</ul>` : '') +\n      (recommended.length ? `<p><b>Read first:</b> ${recommended.map(esc).join(' \u00b7 ')}</p>` : '') +\n      (list(ai.open_questions).length ? `<p><b>Open questions:</b></p><ul>${list(ai.open_questions).map(t => `<li>${esc(t)}</li>`).join('')}</ul>` : '')\n    : `<p>${g.paper_count} new paper(s) matched your topic.</p>`;\n\n  const cards = g.papers.map(p => `\n    <div style=\"border:1px solid #ddd;border-radius:8px;padding:12px;margin:12px 0\">\n      <h3 style=\"margin:0 0 4px\"><a href=\"${esc(p.url)}\">${esc(p.title)}</a></h3>\n      <div style=\"color:#666;font-size:13px\">${esc(list(p.authors).slice(0, 5).join(', '))} \u00b7 ${esc(String(p.publication_date || '').slice(0, 10))} \u00b7 ${esc(p.category || '')} \u00b7 relevance ${Number(p.relevance_score || 0).toFixed(2)}</div>\n      <p>${esc(p.summary)}</p>\n      ${list(p.key_findings).length ? `<ul>${list(p.key_findings).map(f => `<li>${esc(f)}</li>`).join('')}</ul>` : ''}\n      <div style=\"font-size:13px\">${p.drive_file_url ? `<a href=\"${esc(p.drive_file_url)}\">PDF in Drive</a> \u00b7 ` : (p.pdf_url ? `<a href=\"${esc(p.pdf_url)}\">PDF</a> \u00b7 ` : '')}<i>${esc(p.citation_apa || '')}</i></div>\n    </div>`).join('');\n\n  return { json: {\n    ...g,\n    ai_overview_ok: !!ai?.overview,\n    subject: `Research digest: ${g.topic} \u2013 ${g.paper_count} new paper(s)`,\n    html: `<div style=\"font-family:Arial,sans-serif;max-width:720px\"><h2>Hi ${esc(g.researcher)},</h2>\n      <p>Here is your ${esc(g.frequency)} research digest for <b>${esc(g.topic)}</b>.</p>${intro}${cards}\n      <p style=\"color:#888;font-size:12px\">AI Research Assistant Platform \u00b7 topic ${esc(g.topic_id)}</p></div>`\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
