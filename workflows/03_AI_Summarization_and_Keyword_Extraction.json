      "parameters": {
        "jsCode": "const all = $input.all();\nconst ok = all.filter(i => i.json.ai_ok).length;\nconst failed = all.length - ok;\nreturn [{ json: {\n  workflow: $workflow.name,\n  event: 'papers_summarized',\n  level: failed ? 'warning' : 'info',\n  message: `${ok} paper(s) summarized, ${failed} AI failure(s)`,\n  details: { failed_papers: all.filter(i => !i.json.ai_ok).map(i => ({ paper_id: i.json.paper_id, error: i.json.processing_error })) },\n  execution_id: $execution.id\n}}];"
