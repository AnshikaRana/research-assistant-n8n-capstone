      "name": "Get Unprocessed Papers"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a research assistant that summarizes academic papers for a researcher.\nResearch Topic: {{ $json.topic || $json.keywords }}\nPaper Title: {{ $json.title }}\nAuthors: {{ $json.authors }}\nAbstract: {{ $json.abstract }}\n\nUsing ONLY the information above, return ONLY valid JSON in exactly this format:\n{\n\"summary\": \"3-4 sentence plain-English summary\",\n\"key_findings\": [\"finding 1\", \"finding 2\"],\n\"methodology\": \"one sentence on the method/approach\",\n\"datasets\": [\"dataset names mentioned, else empty\"],\n\"models\": [\"model/architecture names mentioned, else empty\"],\n\"limitations\": [\"stated or evident limitations, else empty\"],\n\"research_gap\": \"one sentence\",\n\"research_significance\": \"one sentence on why it matters for the topic\",\n\"extracted_keywords\": [\"5-8 lowercase keywords\"],\n\"research_category\": \"one short category label, e.g. NLP, Computer Vision, Reinforcement Learning\"\n}\nRules:\n- Do not invent datasets, models or numbers that are not in the abstract.\n- Do not return Markdown.\n- Do not return any text outside the JSON object.",
        "messages": {
          "messageValues": []
        },
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 1000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        480,
        0
      ],
      "id": "9c9f69d7-ed97-41f5-8fd9-d35fa3a23833",
      "name": "Summarize Paper",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        480,
        220
      ],
      "id": "6eb18ae8-a5d6-4451-931a-5d7805493eaf",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode": "function parseLlmJson(text) {\n  const raw = String(text ?? '')\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/```\\s*$/, '')\n    .trim();\n  return JSON.parse(raw);\n}\n\n// Validate every AI summary before it is written to the Data Table.\nconst papers = $('Get Unprocessed Papers').all();\nconst asList = v => Array.isArray(v) ? v.map(String).filter(Boolean) : [];\nconst asText = v => (typeof v === 'string' && v.trim()) ? v.trim() : null;\n\nreturn $input.all().map((item, index) => {\n  const paper = papers[index]?.json || {};\n  let out;\n  try {\n    if (item.json.error) throw new Error('AI call failed: ' + (item.json.error.message || item.json.error));\n    const p = parseLlmJson(item.json.text);\n    const summary = asText(p.summary);\n    if (!summary) throw new Error('AI output has no summary');\n    out = {\n      ai_ok: true,\n      summary,\n      key_findings: JSON.stringify(asList(p.key_findings)),\n      methodology: asText(p.methodology),\n      datasets: JSON.stringify(asList(p.datasets)),\n      models: JSON.stringify(asList(p.models)),\n      limitations: JSON.stringify(asList(p.limitations)),\n      research_gap: asText(p.research_gap),\n      research_significance: asText(p.research_significance),\n      extracted_keywords: asList(p.extracted_keywords).map(k => k.toLowerCase()).join(', '),\n      research_category: asText(p.research_category) || 'Uncategorized',\n      processing_error: ''\n    };\n  } catch (e) {\n    out = { ai_ok: false, processing_error: String(e.message).slice(0, 500) };\n  }\n  return { json: { paper_id: paper.paper_id, title: paper.title, ...out } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        0
      ],
      "id": "f8a43a70-7645-4d66-9365-55e20c1b51fa",
