      "id": "41ffcf93-0c8e-4969-9bfd-3083ff23aa9c",
      "name": "Parse arXiv Results"
    },
    {
      "parameters": {
        "url": "https://api.semanticscholar.org/graph/v1/paper/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{$json.search_query}}"
            },
            {
              "name": "limit",
              "value": "1"
            },
            {
              "name": "fields",
              "value": "title,abstract,authors,year,url,externalIds,publicationDate,openAccessPdf"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 3000
            }
          },
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        752,
        -240
      ],
      "id": "6355ec6e-c12f-4918-8d81-f8370c35ada0",
      "name": "Search Semantic Scholar",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst topicItems = $('Build Search Query').all();\nconst inputItems = $input.all();\n\nfor (let i = 0; i < inputItems.length; i++) {\n  const item = inputItems[i];\n  // Failed / rate-limited request -> item has `error` and no data -> zero results\n  const papers = Array.isArray(item.json.data) ? item.json.data : [];\n\n  // This API response corresponds to the topic at the same input index.\n  const topic = topicItems[i]?.json || {};\n\n  for (const paper of papers) {\n    results.push({\n      json: {\n        topic_id: topic.topic_id,\n        topic: topic.topic,\n        keywords: topic.keywords,\n        researcher: topic.researcher,\n\n        paper_id_external: paper.paperId,\n        title: paper.title || null,\n        abstract: paper.abstract || null,\n        year: paper.year || null,\n        publication_date: paper.publicationDate || null,\n\n        authors: (paper.authors || []).map(a => a.name),\n\n        url: paper.url || null,\n        pdf_url: paper.openAccessPdf?.url || null,\n\n        arxiv_id: paper.externalIds?.ArXiv || null,\n        doi: paper.externalIds?.DOI || null\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -240
      ],
      "id": "b51dcc8e-67d0-42bd-822f-19b6be61ee7e",
      "name": "Parse Semantic Scholar Results"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const p = item.json;\n\n  let dedupe_key;\n\n  // Prefer arXiv ID because both sources commonly expose it.\n  if (p.arxiv_id) {\n    dedupe_key = `arxiv:${p.arxiv_id.toLowerCase().trim()}`;\n  }\n  // Fall back to DOI.\n  else if (p.doi) {\n    dedupe_key = `doi:${p.doi.toLowerCase().trim()}`;\n  }\n  // Final fallback: normalized title + year.\n  else {\n    const title = (p.title || \"\")\n      .toLowerCase()\n      .replace(/[^\\w\\s]/g, \"\")\n      .replace(/\\s+/g, \" \")\n      .trim();\n\n    dedupe_key = `title:${title}|year:${p.year || \"\"}`;\n  }\n\n  return {\n    json: {\n      ...p,\n      dedupe_key\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -240
      ],
      "id": "0d103908-5bb2-4dba-b64e-926eb9a64a59",
      "name": "Generate Dedupe Key - Semantic Scholar"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const p = item.json;\n\n  let dedupe_key;\n\n  // Prefer arXiv ID because both sources commonly expose it.\n  if (p.arxiv_id) {\n    dedupe_key = `arxiv:${p.arxiv_id.toLowerCase().trim()}`;\n  }\n  // Fall back to DOI.\n  else if (p.doi) {\n    dedupe_key = `doi:${p.doi.toLowerCase().trim()}`;\n  }\n  // Final fallback: normalized title + year.\n  else {\n    const title = (p.title || \"\")\n      .toLowerCase()\n      .replace(/[^\\w\\s]/g, \"\")\n      .replace(/\\s+/g, \" \")\n      .trim();\n\n    dedupe_key = `title:${title}|year:${p.year || \"\"}`;\n  }\n\n  return {\n    json: {\n      ...p,\n      dedupe_key\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -16
      ],
      "id": "eb0ac5b3-1477-49da-9b17-6bb55279c281",
      "name": "Generate Dedupe Key - arXiv"
    },
    {
      "parameters": {
        "jsCode": "// Remove duplicates inside the arXiv result set (per topic: the same\n// paper may legitimately be stored for two different topics)\nconst seen = new Set();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const key = `${item.json.topic_id}::${item.json.dedupe_key}`;\n\n  if (!seen.has(key)) {\n    seen.add(key);\n    results.push(item);\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -16
      ],
      "id": "10288b32-0f3a-4367-bbb1-6223adb8d807",
      "name": "Remove Duplicates"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1568,
        -144
      ],
      "id": "1f5803cb-cada-4aa6-b1dc-b5992c1e189a",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "// Cross-source de-duplication (per topic). When the same paper comes from\n// Semantic Scholar AND arXiv, keep one record but fill any empty field\n// from the other source so good metadata is never replaced by null.\nconst isEmpty = v => v === null || v === undefined || v === '' ||\n  (Array.isArray(v) && v.length === 0);\n\nconst byKey = new Map();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const key = item.json.dedupe_key\n    ? `${item.json.topic_id}::${item.json.dedupe_key}`\n    : null;\n\n  if (!key) {\n    results.push(item);\n    continue;\n  }\n\n  if (!byKey.has(key)) {\n    const copy = { json: { ...item.json } };\n    byKey.set(key, copy);\n    results.push(copy);\n  } else {\n    const kept = byKey.get(key).json;\n    for (const [field, value] of Object.entries(item.json)) {\n      if (isEmpty(kept[field]) && !isEmpty(value)) kept[field] = value;\n    }\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -144
      ],
      "id": "230d94d6-04ca-4f10-a319-7638816bb18a",
      "name": "Remove Cross-Source Duplicates"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const p = item.json;\n\n  const year =\n    p.year ??\n    (p.published ? new Date(p.published).getFullYear() : null) ??\n    (p.publication_date\n      ? new Date(p.publication_date).getFullYear()\n      : null);\n\n  const publication_date =\n    p.publication_date ||\n    p.published ||\n    p.updated ||\n    null;\n\n  return {\n    json: {\n      paper_id: `PAPER-${Date.now()}-${index + 1}`,\n\n      title: p.title || null,\n      authors: Array.isArray(p.authors) ? p.authors : [],\n      abstract: p.abstract || null,\n\n      year: year,\n      publication_date: publication_date,\n\n      doi: p.doi || null,\n      arxiv_id: p.arxiv_id || null,\n      url: p.url || null,\n\n      // PDF link known != PDF downloaded. 04 downloads it and updates pdf_status.\n      pdf_url: p.pdf_url || null,\n      pdf_status: p.pdf_url ? 'link_found' : 'no_link',\n\n      source: p.paper_id_external ? \"semantic_scholar\" : \"arxiv\",\n\n      topic_id: p.topic_id || null,\n      topic: p.topic || null,\n      keywords: p.keywords || null,\n      researcher: p.researcher || null,\n\n      dedupe_key: p.dedupe_key || null,\n\n      summary: null,\n      key_findings: [],\n      methodology: null,\n      datasets: [],\n      models: [],\n      limitations: [],\n      research_gap: null,\n      research_significance: null,\n\n      relevance_score: null,\n      relevant: null,\n      processed: false,\n\n      created_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
