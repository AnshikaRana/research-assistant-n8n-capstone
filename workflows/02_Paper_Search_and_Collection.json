        "jsCode": "return $input.all().map(item => ({\n  json: {\n    paper_id: item.json.paper_id,\n    topic_id: item.json.topic_id,\n    title: item.json.title,\n    relevance_score: item.json.relevance_score,\n    relevant: false,\n    reason: item.json.relevance_reason || null,\n    filtered_at: new Date().toISOString()\n  }\n}));"
