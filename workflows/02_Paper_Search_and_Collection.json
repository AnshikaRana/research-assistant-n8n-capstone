    },
    {
      "parameters": {
        "jsCode": "// One audit event per run for workflow 06 (warning if the AI step failed)\nconst ran = n => { try { return $(n).all(); } catch { return []; } };\nconst saved = ran('Insert row').length;\nconst filtered = ran('Log Filtered Paper');\nconst aiFailures = filtered.filter(i => String(i.json.reason || '').startsWith('AI ')).length;\nreturn [{ json: {\n  workflow: $workflow.name,\n  event: 'papers_collected',\n  level: aiFailures ? 'warning' : 'info',\n  message: `${saved} relevant new paper(s) saved, ${filtered.length} filtered out` +\n           (aiFailures ? ` (${aiFailures} because the AI relevance check failed)` : ''),\n  details: {\n    topics_searched: $('Build Search Query').all().length,\n    candidates_after_dedupe: $('Normalize Paper Metadata').all().length,\n    new_candidates: $('Skip Already Stored Papers').all().length,\n    saved, filtered: filtered.length, ai_failures: aiFailures\n  },\n  execution_id: $execution.id\n}}];"
      },
