    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a research-paper relevance classifier.\nDetermine how relevant the following paper is to the researcher's registered research topic.\nResearch Topic: {{$json.topic}}\nResearch Keywords: {{$json.keywords}}\nPaper Title: {{$json.title}}\nPaper Abstract: {{$json.abstract}}\nReturn ONLY valid JSON in exactly this format:  \n{\n\"relevant\": true,\n\"relevance_score\": 0.92,\n\"reason\": \"Brief explanation of why the paper is or is not relevant.\" \n}\nRules: \n- relevance_score must be between 0 and 1. \n- relevant must be true when relevance_score >= 0.70. \n- relevant must be false when relevance_score < 0.70. \n- Do not return Markdown. \n- Do not return any text outside the JSON object.",
        "messages": {
          "messageValues": []
        },
        "batching": {
          "batchSize": 5,
          "delayBetweenBatches": 1000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2352,
        -144
      ],
      "id": "182edf40-c3a2-411d-af93-17998528071d",
      "name": "Basic LLM Chain",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini",
          "cachedResultUrl": ""
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
