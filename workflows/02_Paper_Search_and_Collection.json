      ],
      "id": "28def601-07c1-4059-b153-77d7a7a75a77",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode": "// LLM output is untrusted: strip code fences, parse, validate, and decide\n// relevance deterministically from the score (>= 0.70, as the prompt defines).\nconst originalItems = $('Skip Already Stored Papers').all();\nconst llmItems = $input.all();\n\nreturn llmItems.map((item, index) => {\n  const raw = String(item.json.text ?? '')\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/```\\s*$/, '')\n    .trim();\n  const original = originalItems[index]?.json || {};\n\n  let parsed = null;\n  let aiError = null;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch (error) {\n    aiError = item.json.error ? 'AI relevance call failed' : 'AI returned invalid JSON';\n  }\n\n  let score = Number(parsed?.relevance_score);\n  if (!aiError && (!Number.isFinite(score) || score < 0 || score > 1)) {\n    aiError = 'AI returned an out-of-range relevance_score';\n  }\n  if (aiError) score = 0;\n\n  return {\n    json: {\n      ...original,\n\n      relevant: score >= 0.7,\n      relevance_score: score,\n      relevance_reason: aiError || String(parsed.reason || '')\n    }\n  };\n});"
      },
