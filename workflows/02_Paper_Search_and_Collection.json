      "position": [
        752,
        -16
      ],
      "id": "04369251-6ae3-4285-b961-450ca5eb68f2",
      "name": "Search arXiv",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\n// Get the original topic data directly from Build Search Query\nconst topicItems = $('Build Search Query').all();\nconst inputItems = $input.all();\n\nconst clean = s => (s || '').replace(/\\s+/g, ' ').trim() || null;\n\nfor (let index = 0; index < inputItems.length; index++) {\n  const item = inputItems[index];\n  // A failed request (retries exhausted) arrives here as an item with `error`:\n  // treat it as zero results so one bad topic does not stop the run.\n  const xml = typeof item.json.data === 'string' ? item.json.data : '';\n\n  // Match this arXiv response to the corresponding topic by item position.\n  const topic = topicItems[index]?.json || {};\n\n  const entries = xml.match(/<entry>[\\s\\S]*?<\\/entry>/g) || [];\n\n  for (const entry of entries) {\n    const getTag = (tag) => {\n      const match = entry.match(\n        new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`)\n      );\n      return match ? match[1].trim() : null;\n    };\n\n    const id = getTag(\"id\");\n\n    const authors = [...entry.matchAll(\n      /<author>[\\s\\S]*?<name>(.*?)<\\/name>[\\s\\S]*?<\\/author>/g\n    )].map(match => match[1].trim());\n\n    const arxivId = id\n      ? id.match(/abs\\/(.+?)(?:v\\d+)?$/)?.[1] || null\n      : null;\n\n    // arXiv exposes the PDF as <link title=\"pdf\" href=\"...\"/>\n    const pdfLink = [...entry.matchAll(/<link\\b[^>]*>/g)]\n      .map(m => m[0])\n      .find(tag => /title=\"pdf\"/.test(tag));\n    const pdfUrl = pdfLink?.match(/href=\"([^\"]+)\"/)?.[1]?.replace('http://', 'https://') || null;\n\n    const published = getTag(\"published\");\n    const updated = getTag(\"updated\");\n\n    results.push({\n      json: {\n        topic_id: topic.topic_id,\n        topic: topic.topic,\n        keywords: topic.keywords,\n        researcher: topic.researcher,\n\n        arxiv_id: arxivId,\n        title: clean(getTag(\"title\")),\n        abstract: clean(getTag(\"summary\")),\n\n        // Preserve publication metadata\n        published: published,\n        updated: updated,\n        publication_date: published || updated || null,\n\n        doi: getTag(\"arxiv:doi\"),\n        authors,\n        url: id ? id.replace(\"http://\", \"https://\") : null,\n        pdf_url: pdfUrl\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
