          "values": [
            {
              "fieldLabel": "Researcher Name",
              "fieldName": "researcher",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Address",
              "fieldType": "email",
              "fieldName": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Research Topic",
              "fieldName": "topic",
              "requiredField": true
            },
            {
              "fieldLabel": "Research Keywords",
              "fieldName": "keywords",
              "placeholder": "comma separated, e.g. transformers, attention",
              "requiredField": true
            },
            {
              "fieldLabel": "Research Frequency",
              "fieldType": "dropdown",
              "fieldName": "frequency",
              "fieldOptions": {
                "values": [
                  {
                    "option": "daily"
                  },
                  {
                    "option": "weekly"
                  },
                  {
                    "option": "monthly"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        96,
        0
      ],
      "id": "0684be7d-2601-443a-af92-1592dc7d8466",
